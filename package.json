{
  "name": "conan",
  "version": "1.0.0",
  "description": "ローカルで「人間 vs CPU」「CPU vs CPU」が遊べる、 名探偵コナントレーディングカードゲーム（タカラトミー公式）の **個人利用限定** Webアプリ。",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --maxWorkers=8",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "docs:api": "tsx scripts/gen-docs/index.ts api",
    "docs:state": "tsx scripts/gen-docs/index.ts state",
    "docs:flows": "tsx scripts/gen-docs/index.ts flows",
    "docs:progress": "tsx scripts/gen-docs/index.ts progress",
    "docs:mapping": "tsx scripts/gen-docs/index.ts mapping",
    "docs:structure": "tsx scripts/gen-docs/index.ts structure",
    "docs:changelog": "tsx scripts/gen-docs/index.ts changelog",
    "docs:qa-trace": "tsx scripts/gen-docs/index.ts qa-trace",
    "docs:codex-context": "node scripts/gen-codex-context.mjs",
    "docs": "tsx scripts/gen-docs/index.ts all",
    "docs:check": "tsx scripts/gen-docs/index.ts check",
    "lint:bugs": "tsx scripts/lint-bug-frontmatter.ts",
    "lint:listener": "tsx scripts/lint-listener-scope.ts",
    "lint:card-addition": "tsx scripts/lint-card-addition.ts",
    "bug:trend": "tsx scripts/bug-trend.ts",
    "check:smoke-baseline": "tsx scripts/check-smoke-baseline.ts",
    "test:coverage": "vitest run --coverage",
    "check:coverage": "tsx scripts/check-coverage.ts",
    "lint:test-pair": "tsx scripts/lint-test-pair.ts",
    "lint:side-channel": "tsx scripts/lint-side-channel.ts",
    "lint:component-testid": "tsx scripts/lint-component-testid.ts",
    "lint:ok-false-pattern": "tsx scripts/lint-ok-false-pattern.ts",
    "lint:icon-abilities": "tsx scripts/lint-icon-abilities.ts",
    "smoke:1000": "tsx scripts/smoke/run-1000.ts",
    "benchmark": "tsx scripts/benchmark/run.ts",
    "cards:fetch": "node scripts/cards/fetch-official.cjs",
    "cards:case-difficulties": "node scripts/cards/generate-case-difficulties.cjs",
    "gen:meta-card-identities": "tsx scripts/gen-meta-card-identities.ts",
    "check:meta-card-identities": "npm run gen:meta-card-identities && git diff --exit-code -- meta-app/src/data/cardIdentities.generated.ts",
    "cards:status": "node scripts/cards/cards-data-status.cjs",
    "cards:qa-snapshot": "node scripts/cards/write-qa-hash-snapshot.cjs",
    "cards:check": "node scripts/cards/check-official-sync.cjs",
    "cards:check:live-status": "node scripts/cards/check-official-sync.cjs --live-status",
    "cards:sync": "npm run cards:fetch && npm run cards:case-difficulties && node scripts/compiler/tsv-corpus.cjs && tsx scripts/compiler/dump-shipped.ts && node scripts/compiler/mine.cjs && node scripts/compiler/oracle.cjs --gate",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:private-hosted": "tsx scripts/private-hosted/run-local-qualification.ts --mode standalone",
    "test:e2e:private-hosted:prepared": "tsx scripts/private-hosted/run-local-qualification.ts --mode prepared",
    "private-hosted:boundary:advanced": "tsx scripts/private-hosted/audit-runtime-boundary.ts",
    "private-hosted:scan-secrets": "tsx scripts/private-hosted/audit-release-basics.ts secrets",
    "private-hosted:scan-destinations": "tsx scripts/private-hosted/audit-release-basics.ts destinations",
    "private-hosted:bug-gate": "tsx scripts/private-hosted/check-release-bugs.ts",
    "private-hosted:qualify-final": "tsx scripts/private-hosted/run-final-qualification.ts",
    "private-hosted:init": "tsx scripts/private-hosted/init-config.ts",
    "private-hosted:audit": "tsx scripts/private-hosted/verify-access.ts",
    "dev:meta": "vite --config meta-app/vite.config.meta.ts",
    "build:meta": "vite build --config meta-app/vite.config.meta.ts",
    "preview:meta": "vite preview --config meta-app/vite.config.meta.ts",
    "test:meta:e2e": "playwright test --config meta-app/playwright.config.ts",
    "hybrid:prepare": "node scripts/hybrid/prepare.cjs",
    "hybrid:finish": "node scripts/hybrid/finish.cjs",
    "gen:probes": "tsx scripts/compiler/dump-shipped.ts && node scripts/gen-card-probes.cjs",
    "ground": "node scripts/ground-dossier.cjs",
    "sync:codex-skills": "node scripts/sync-codex-skills.mjs",
    "check:codex-migration": "node scripts/check-codex-migration.mjs",
    "check:codex-efficiency": "node scripts/check-codex-efficiency.mjs",
    "check:codex-quality": "node scripts/check-codex-quality.mjs",
    "check:wave-scope": "tsx scripts/check-wave-scope.ts",
    "check:you-vs-cpu-loop": "tsx scripts/you-vs-cpu-validation-loop.ts",
    "tcg:packet:build": "node scripts/build-tcg-runtime-packet.mjs --manifest .claude/specs/tcg-expert-play/row-026-runtime-input.json --registry .claude/research/tcg-expert-play/runtime-source-register.json --output .claude/sessions/row-026-runtime-packet.json",
    "lint:bug-closure": "tsx scripts/lint-bug-closure.ts",
    "lint:qa": "tsx scripts/lint-qa-trace.ts",
    "qa:adjudication:bootstrap": "tsx scripts/qa-adjudication.ts --bootstrap",
    "qa:adjudication:queue": "tsx scripts/qa-adjudication.ts --queue",
    "qa:adjudication:merge": "tsx scripts/qa-adjudication.ts --check",
    "qa:adjudication:verify-local": "tsx scripts/qa-adjudication.ts --check --with-local-raw"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "immer": "^11.1.8",
    "jsdom": "^29.1.1",
    "lightningcss": "1.32.0",
    "parse5": "8.0.1",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "8.0.16",
    "vitest": "^4.1.5",
    "wrangler": "4.118.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run docs:check && npm run lint:bugs && npm run lint:listener && npm run lint:card-addition && npm run lint:side-channel && npm run lint:component-testid && npm run lint:ok-false-pattern && npm run lint:test-pair && npm run lint:icon-abilities"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
