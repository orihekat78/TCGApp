{
  "name": "conan",
  "version": "1.0.0",
  "description": "ローカルで「人間 vs CPU」「CPU vs CPU」が遊べる、 名探偵コナントレーディングカードゲーム（タカラトミー公式）の **個人利用限定** Webアプリ。",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "docs:api": "tsx scripts/gen-docs/index.ts api",
    "docs:state": "tsx scripts/gen-docs/index.ts state",
    "docs:flows": "tsx scripts/gen-docs/index.ts flows",
    "docs:progress": "tsx scripts/gen-docs/index.ts progress",
    "docs:mapping": "tsx scripts/gen-docs/index.ts mapping",
    "docs": "tsx scripts/gen-docs/index.ts all",
    "docs:check": "tsx scripts/gen-docs/index.ts check",
    "smoke:1000": "tsx scripts/smoke/run-1000.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.3.0",
    "immer": "^11.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run docs:check"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  }
}
