{"package":"CT-D03 Case-StartDeck 03 怪盗キッド","data":[{"id":193,"card_id":"P004","title":"怪盗キッド","card_num":"D03001","show_hide":"表示","date":"2024-03-01 10:00:00","package":"CT-D03 Case-StartDeck 03 怪盗キッド","category1":null,"category2":null,"category3":null,"region":"日本","main_thumb":"D03001.jpg","main_path":"1714013117395180.jpg","sub_thumb":"sub_D03001.jpg","sub_path":"1734394649613616.jpg","color":"白","type":"パートナー","rarity":"D","cost":null,"ap":null,"lp":"1","feature":"【解決編】【事件解決】【スリープ】：自分の証拠が事件レベルの数以上ある場合、ゲームに勝利する。\n【アシスト】【スリープ】：FILEエリアに移動する。自分のFILEエリアにカードが7枚以上ある場合、事件を解決編にする。","drawing":null,"flavor_txt":null,"difficulty_first":null,"difficulty_second":null,"illustrator":"Line-drawing 青山剛昌","copyright":"©青山剛昌／小学館  ©TOMY","hirameki":null,"cut_in":null,"q_a":"{\"【事件解決】と【アシスト】は、パートナーがスリープ状態でも行えますか？\":\"いいえ。どちらの能力も行うためにパートナーをスリープさせる必要があるので、スリープ状態の場合はできません。\"}","linkto":null,"contain":null,"henso":null,"created_at":"2024-04-25T02:41:50.000000Z","updated_at":"2024-12-17T00:17:29.000000Z","rcp_showhide":1,"rcp_limit":3,"rcp_caution":null,"rcp_sameid_limit":3,"release_date":"2024-05-04 00:00:00"},{"id":194,"card_id":"0119","title":"怪盗キッド","card_num":"D03002","show_hide":"表示","date":"2024-03-01 10:00:00","package":"CT-D03 Case-StartDeck 03 怪盗キッド","category1":"怪盗","category2":null,"category3":null,"region":"日本","main_thumb":"D03002.jpg","main_path":"1714013117398403.jpg","sub_thumb":"sub_D03002.jpg","sub_path":"1734394649619006.jpg","color":"白","type":"キャラ","rarity":"D","cost":"8","ap":"7000","lp":"2","feature":"【パートナー白】【登場時】手札を1枚リムーブしてもよい。そうした場合、キャラを1枚まで選び、スタンさせ、自分は証拠を1つ得る。（スタン状態のキャラをアクティブにする場合、代わりにスリープさせる）","drawing":null,"flavor_txt":null,"difficulty_first":null,"difficulty_second":null,"illustrator":"紙島育","copyright":"©青山剛昌／小学館  ©TOMY","hirameki":null,"cut_in":null,"q_a":"{\"「スタンさせる」とはなんですか？\":\"「スタンさせる」効果を受けたキャラは「スタン状態」となり、カードを上下逆向きにします。スタン状態のキャラは、オートフェイズやカードの効果によってアクティブにする場合、代わりにスリープ状態になります。それまでスタン状態は解除されません。\",\"スタン状態のキャラはアクションで指定できますか？\":\"はい。スリープ状態のキャラと同様に指定できます。\",\"【登場時】能力では、キャラを0枚選んだ場合でも証拠を得ることはできますか？\":\"はい。その場合でも証拠を1つ得ます。\"}","linkto":null,"contain":null,"henso":null,"created_at":"2024-04-25T02:41:50.000000Z","updated_at":"2024-12-17T00:17:29.000000Z","rcp_showhide":1,"rcp_limit":3,"rcp_caution":null,"rcp_sameid_limit":3,"release_date":"2024-05-04 00:00:00"},{"id":195,"card_id":"0120","title":"怪盗キッド","card_num":"D03003","show_hide":"表示","date":"2024-03-01 10:00:00","package":"CT-D03 Case-StartDeck 03 怪盗キッド","category1":"怪盗","category2":null,"category3":null,"region":"日本","main_thumb":"D03003.jpg","main_path":"1714013117401793.jpg","sub_thumb":"sub_D03003.jpg","sub_path":"1734394649625644.jpg","color":"白","type":"キャラ","rarity":"D","cost":"7","ap":"6000","lp":"1","feature":"【パートナー白】〚迅速〛（登場したターンからすぐに推理かアクションできる）","drawing":null,"flavor_txt":null,"difficulty_first":null,"difficulty_second":null,"illustrator":"kicori","copyright":"©青山剛昌／小学館  ©TOMY","hirameki":null,"cut_in":null,"q_a":null,"linkto":null,"contain":null,"henso":null,"created_at":"2024-04-25T02:41:50.000000Z","updated_at":"2024-12-17T00:17:29.000000Z","rcp_showhide":1,"rcp_limit":3,"rcp_caution":null,"rcp_sameid_limit":3,"release_date":"2024-05-04 00:00:00"},{"id":196,"card_id":"0121","title":"怪盗キッド","card_num":"D03004","show_hide":"表示","date":"2024-03-01 10:00:00","package":"CT-D03 Case-StartDeck 03 怪盗キッド","category1":"怪盗","category2":null,"category3":null,"region":"日本","main_thumb":"D03004.jpg","main_path":"1714013117404423.jpg","sub_thumb":"sub_D03004.jpg","sub_path":"1734394649629750.jpg","color":"白","type":"キャラ","rarity":"D","cost":"4","ap":"4000","lp":"1","feature":"【相手ターン中】【現場リムーブ時】レベル5以下のスリープ状態のキャラを1枚まで選び、スタンさせる。（スタン状態のキャラをアクティブにする場合、代わりにスリープさせる）","drawing":null,"flavor_txt":null,"difficulty_first":null,"difficulty_second":null,"illustrator":null,"copyright":"©青山剛昌／小学館  ©TOMY","hirameki":"【ヒラメキ】（証拠からリムーブされるときに発動する）カードを1枚引く。","cut_in":null,"q_a":"{\"「スタンさせる」とはなんですか？\":\"「スタンさせる」効果を受けたキャラは「スタン状態」となり、カードを上下逆向きにします。スタン状態のキャラは、オートフェイズやカードの効果によってアクティブにする場合、代わりにスリープ状態になります。それまでスタン状態は解除されません。\",\"スタン状態のキャラはアクションで指定できますか？\":\"はい。スリープ状態のキャラと同様に指定できます。\",\"【相手ターン中】【現場リムーブ時】とはなんですか？\":\"【現場リムーブ時】の能力は、現場にいるこのキャラがリムーブされた（リムーブエリアに置かれた）ときに発動します。なのでこの能力は、相手のターン中に現場からリムーブされたときに発動します。\"}","linkto":null,"contain":null,"henso":null,"created_at":"2024-04-25T02:41:50.000000Z","updated_at":"2024-12-17T00:17:29.000000Z","rcp_showhide":1,"rcp_limit":3,"rcp_caution":null,"rcp_sameid_limit":3,"release_date":"2024-05-04 00:00:00"},{"id":197,"card_id":"0122","title":"中森青子","card_num":"D03005","show_hide":"表示","date":"2024-03-01 10:00:00","package":"CT-D03 Case-StartDeck 03 怪盗キッド","category1":"高校生","category2":null,"category3":null,"region":"日本","main_thumb":"D03005.jpg","main_path":"1714013117407011.jpg","sub_thumb":"sub_D03005.jpg","sub_path":"1734394649633166.jpg","color":"白","type":"キャラ","rarity":"D","cost":"2","ap":"1000","lp":"1","feature":null,"drawing":null,"flavor_txt":null,"difficulty_first":null,"difficulty_second":null,"illustrator":"kicori","copyright":"©青山剛昌／小学館  ©TOMY","hirameki":null,"cut_in":"【カットイン】AP＋2000（コンタクト中に手札からリムーブして使う）","q_a":null,"linkto":null,"contain":null,"henso":null,"created_at":"2024-04-25T02:41:50.000000Z","updated_at":"2024-12-17T00:17:29.000000Z","rcp_showhide":1,"rcp_limit":3,"rcp_caution":null,"rcp_sameid_limit":3,"release_date":"2024-05-04 00:00:00"},{"id":198,"card_id":"0123","title":"中森銀三","card_num":"D03006","show_hide":"表示","date":"2024-03-01 10:00:00","package":"CT-D03 Case-StartDeck 03 怪盗キッド","category1":"警察,警視庁","category2":null,"category3":null,"region":"日本","main_thumb":"D03006.jpg","main_path":"1714013117409326.jpg","sub_thumb":"sub_D03006.jpg","sub_path":"1734394649637264.jpg","color":"白","type":"キャラ","rarity":"D","cost":"5","ap":"5000","lp":"0","feature":"【パートナー白】〚突撃〛（登場したターンからすぐにアクションできる）","drawing":null,"flavor_txt":null,"difficulty_first":null,"difficulty_second":null,"illustrator":null,"copyright":"©青山剛昌／小学館  ©TOMY","hirameki":null,"cut_in":null,"q_a":null,"linkto":null,"contain":null,"henso"